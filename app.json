{
  "expo": {
    "name": "Gold House Alpha",
    "slug": "gold-house-alpha",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gold-house-alpha",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
